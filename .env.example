# Copie para .env e ajuste. Valores abaixo servem apenas ao ambiente local.
PACTOR_ENVIRONMENT=development
PACTOR_DEBUG=false
PACTOR_SECRET_KEY=troque-esta-chave-local
PACTOR_ALLOWED_HOSTS=localhost,127.0.0.1,web
PACTOR_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PACTOR_PUBLIC_URL=http://localhost:8000
PACTOR_SECURE_COOKIES=false
PACTOR_LOG_LEVEL=INFO
PACTOR_ADMIN_PATH=admin/
PACTOR_TRIAL_PLAN=profissional

# PostgreSQL: superusuário do container (somente inicialização do volume)
POSTGRES_SUPERUSER_PASSWORD=postgres-local
# Papel proprietário (migrations) e papel da aplicação (processos web/worker)
PACTOR_OWNER_PASSWORD=owner-local
PACTOR_APP_PASSWORD=app-local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pactor

RABBITMQ_USER=pactor
RABBITMQ_PASSWORD=pactor-local
CELERY_BROKER_URL=amqp://pactor:pactor-local@rabbitmq:5672/pactor
REDIS_URL=redis://redis:6379/0

EMAIL_HOST=mailpit
EMAIL_PORT=1025

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
